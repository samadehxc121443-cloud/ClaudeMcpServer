# Copy to .env and fill in real values. NEVER commit .env.
#   cp .env.example .env

# ── Environment ──
# Development: verbose errors, DI validation on startup.
# Production: terse errors, lazy resolution.
ASPNETCORE_ENVIRONMENT=Development

# ── PostgreSQL (internal network only — no host port) ──
POSTGRES_USER=licenses
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=licenses

# ── Redis (internal network only — no host port) ──
REDIS_PASSWORD=change-me-redis-password

# ── Vault (internal network only — no host port) ──
# Root token for Vault dev mode. The app and vault-init authenticate with it.
VAULT_TOKEN=change-me-vault-root-token

# ── Keycloak (exposed: browser login + admin console) ──
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin-password
KEYCLOAK_PORT=8085

# ── LicenseServer ──
# NOTE: there is no ADMIN_KEY here on purpose. Admin keys are data and live
# in the database (seeded by docker/postgres/init/02-seed.sql, or generated
# and logged on first start if the table is empty).
LICENSE_SERVER_PORT=8080
