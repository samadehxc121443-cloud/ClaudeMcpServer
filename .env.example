# Copy to .env and fill in real values. NEVER commit .env.
#   cp .env.example .env

# ── PostgreSQL (generic service: docker/compose.postgres.yml) ──
POSTGRES_USER=licenses
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=licenses
POSTGRES_PORT=5432

# ── Redis (generic service: docker/compose.redis.yml) ──
REDIS_PORT=6379

# ── Vault (generic service: docker/compose.vault.yml) ──
# Root token for Vault dev mode. The app and vault-init authenticate with it.
VAULT_TOKEN=change-me-vault-root-token
VAULT_PORT=8200

# ── LicenseServer ──
# Seeded into Vault by vault-init; the app reads it from Vault, not from here.
# Generate one with PowerShell:
#   -join ((1..32 | ForEach-Object { '{0:X2}' -f (Get-Random -Max 256) }))
ADMIN_KEY=change-me-64-hex-chars
LICENSE_SERVER_PORT=8080
